{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>scottlz0310/renovate-config//presets/default",
    "github>scottlz0310/renovate-config//presets/languages/python",
    "github>scottlz0310/renovate-config//presets/languages/docker",
    "github>scottlz0310/renovate-config//presets/tools/precommit",
    "github>scottlz0310/renovate-config//presets/options/automerge",
    "github>scottlz0310/renovate-config//presets/options/schedule",
    "github>scottlz0310/renovate-config//presets/options/security"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track uv version in pyproject.toml [tool.uv] required-version",
      "managerFilePatterns": ["/(^|/)pyproject\\.toml$/"],
      "matchStrings": [
        "required-version\\s*=\\s*\"==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "astral-sh/uv",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track uv version in Dockerfile ARG UV_VERSION defaults",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "ARG UV_VERSION=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "astral-sh/uv",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Wait for uv GitHub release artifacts to settle before bumping uv",
      "matchPackageNames": ["astral-sh/uv"],
      "minimumReleaseAge": "3 days"
    }
  ]
}
