# ============================================================
# spotify-ad-analyzer 環境設定テンプレート
# このファイルを .env にコピーして値を書き換えてください。
#   cp .env.example .env
# ============================================================

# -------------------------------------------------------
# [必須] recorder が WAV を保存するホスト側フォルダのパス
#   Docker がこのフォルダをコンテナ内の /app/shared にマウントします。
#   spotify-ad-recorder の保存先に合わせて変更してください。
# -------------------------------------------------------
HOST_SHARED_DIR=C:\Users\<YourName>\path\to\recorder\shared

# -------------------------------------------------------
# [必須] Hugging Face アクセストークン（話者分離モデルに必要）
#   取得先: https://huggingface.co/settings/tokens
#   モデル承認: https://huggingface.co/pyannote/speaker-diarization-3.1
# -------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -------------------------------------------------------
# [任意] faster-whisper モデルサイズ
#   選択肢: tiny / base / small / medium / large-v3
#   小さいほど速いが精度が下がります（デフォルト: small）
# -------------------------------------------------------
WHISPER_MODEL=small

# -------------------------------------------------------
# [任意] Ollama 設定（LLM 解析を使う場合のみ）
#   Ollama が不要な場合はそのままで構いません。
# -------------------------------------------------------
OLLAMA_HOST=host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# -------------------------------------------------------
# [Windows 必須] Docker Desktop でファイル監視が効かない場合は 1 に設定
# -------------------------------------------------------
WATCHDOG_FORCE_POLLING=1
